{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unit Test Results",
  "description": "Unit/integration/agent test results with descriptions and error categorization",
  "type": "object",
  "required": ["vertical", "source", "timestamp", "summary", "entries"],
  "properties": {
    "vertical": { "type": "string" },
    "source": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "runtime_models": {
      "type": ["object", "null"],
      "description": "Model/provider routing used by agent behavior tests."
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer", "description": "Assertion failures" },
        "errors": { "type": "integer", "default": 0, "description": "Infrastructure errors (imports, timeouts, etc.)" },
        "skipped": { "type": "integer", "default": 0 },
        "coverage_percent": { "type": ["number", "null"] },
        "duration_seconds": { "type": "number" }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "module", "status"],
        "properties": {
          "name": { "type": "string", "description": "Test method name (e.g. test_rejects_expired_token)" },
          "module": { "type": "string", "description": "Django app module path (e.g. ai_agent.tests.test_agent)" },
          "suite": { "type": ["string", "null"], "description": "Test class name (e.g. WorkoutAgentInputValidationTest). Used for sub-grouping in the dashboard." },
          "description": { "type": ["string", "null"], "description": "Human-readable test description from docstring (e.g. 'Expired JWT tokens should be rejected')" },
          "status": { "type": "string", "enum": ["passed", "failed", "error", "skipped"] },
          "duration_seconds": { "type": ["number", "null"] },
          "error": { "type": ["string", "null"], "description": "Error message from traceback (last line). Only present for failed/error tests." },
          "criteria": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Human-readable pass/fail criteria for non-deterministic agent tests."
          },
          "observations": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Audit notes explaining why the run passed or failed."
          },
          "runtime_models": {
            "type": ["object", "null"],
            "description": "Model/provider routing used for this test entry."
          },
          "tool_calls": {
            "type": "array",
            "items": { "type": "object" },
            "description": "Flattened tool calls for dashboard compatibility."
          },
          "response_text": {
            "type": ["string", "null"],
            "description": "Flattened assistant text for dashboard compatibility."
          },
          "attempts": {
            "type": "array",
            "description": "Per-attempt details for non-deterministic agent tests.",
            "items": {
              "type": "object",
              "required": ["status", "detail", "duration_seconds"],
              "properties": {
                "status": { "type": "string", "enum": ["passed", "failed", "error", "skipped"] },
                "detail": { "type": "string" },
                "duration_seconds": { "type": ["number", "null"] },
                "criteria": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "observations": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "transcript": {
                  "type": "array",
                  "items": { "type": "object" },
                  "description": "Full conversation and tool transcript captured during this attempt."
                }
              }
            }
          }
        }
      }
    }
  }
}
